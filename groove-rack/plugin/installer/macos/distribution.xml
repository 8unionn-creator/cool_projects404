<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Groove Rack</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check><allowed-os-versions><os-version min="10.15"/></allowed-os-versions></volume-check>
  <choices-outline>
    <line choice="default"><line choice="com.coolprojects404.grooverack"/></line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.coolprojects404.grooverack" visible="false"><pkg-ref id="com.coolprojects404.grooverack"/></choice>
  <pkg-ref id="com.coolprojects404.grooverack" version="@VERSION@" onConclusion="none">GrooveRack-core.pkg</pkg-ref>
</installer-gui-script>
